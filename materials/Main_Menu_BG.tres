code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float checkerBend = 10.0;
uniform float passSpeed = 10.0;
uniform float checkersHor = 1.0;
uniform float checkersVert2 = 1.0;
uniform vec4 Checker1 : source_color = vec4(1.000000, 1.000000, 0.000000, 1.000000);
uniform vec4 Checker2 : source_color = vec4(1.000000, 0.000000, 0.000000, 1.000000);



void vertex() {
// Input:2
	vec2 n_out2p0 = UV;
	float n_out2p1 = n_out2p0.r;
	float n_out2p2 = n_out2p0.g;


// FloatParameter:16
	float n_out16p0 = checkerBend;


// FloatOp:15
	float n_out15p0 = n_out2p2 / n_out16p0;


// FloatOp:14
	float n_out14p0 = n_out2p1 + n_out15p0;


// FloatOp:23
	float n_in23p1 = 1.00000;
	float n_out23p0 = mod(n_out14p0, n_in23p1);


// VectorCompose:9
	vec2 n_out9p0 = vec2(n_out23p0, n_out2p2);


// Output:0
	UV = n_out9p0;


}

void fragment() {
// Input:45
	vec2 n_out45p0 = UV;
	float n_out45p1 = n_out45p0.r;
	float n_out45p2 = n_out45p0.g;


// Input:52
	float n_out52p0 = TIME;


// FloatParameter:53
	float n_out53p0 = passSpeed;


// FloatOp:54
	float n_out54p0 = n_out52p0 / n_out53p0;


// FloatOp:60
	float n_out60p0 = n_out45p1 + n_out54p0;


// FloatParameter:6
	float n_out6p0 = checkersHor;


// FloatOp:68
	float n_out68p0 = n_out60p0 * n_out6p0;


// FloatOp:47
	float n_in47p1 = 1.00000;
	float n_out47p0 = mod(n_out68p0, n_in47p1);


// FloatParameter:67
	float n_out67p0 = checkersVert2;


// FloatOp:64
	float n_out64p0 = n_out45p2 * n_out67p0;


// FloatOp:66
	float n_in66p1 = 1.00000;
	float n_out66p0 = mod(n_out64p0, n_in66p1);


// Step:62
	float n_in62p1 = 0.50000;
	float n_out62p0 = step(n_out66p0, n_in62p1);


// FloatOp:74
	float n_out74p0 = n_out47p0 + n_out62p0;


// FloatOp:71
	float n_in71p1 = 0.50000;
	float n_out71p0 = n_out62p0 * n_in71p1;


// FloatOp:69
	float n_out69p0 = n_out74p0 + n_out71p0;


// FloatOp:70
	float n_in70p1 = 1.00000;
	float n_out70p0 = mod(n_out69p0, n_in70p1);


// Step:36
	float n_in36p1 = 0.50000;
	float n_out36p0 = step(n_out70p0, n_in36p1);


// ColorParameter:34
	vec4 n_out34p0 = Checker1;


// ColorParameter:35
	vec4 n_out35p0 = Checker2;


	vec4 n_out33p0;
// Switch:33
	n_out33p0 = mix(n_out35p0, n_out34p0, float(n_out36p0 > 0.0 ? true : false));


// Output:0
	ALBEDO = vec3(n_out33p0.xyz);
	EMISSION = vec3(n_out33p0.xyz);


}
